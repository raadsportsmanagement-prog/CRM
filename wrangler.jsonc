/* La versión publicada del CRM: la app y su almacén en Cloudflare.
   Se publica con `npm run deploy`. Ver nube/README.md. */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crm-raad",
  "account_id": "37a4f1c5346b8417a7e4d73114b5b281", // cuenta ivan@raadsports.com, la del dominio
  "main": "nube/worker.js",
  "compatibility_date": "2026-05-01",

  /* Lo que sale de `vite build`. Sólo /api/ y /mcp pasan por el Worker; el resto lo
     sirve Cloudflare directo, y cualquier otra ruta abre la app. */
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp"]
  },

  /* Workers AI: genera las fotos con personas del Estudio (FLUX.2). */
  "ai": { "binding": "AI" },

  /* Cuaderno guarda los datos; Operador es la fila de los agentes, que
     contestan los WhatsApp con el CRM cerrado (nube/operacion.js). */
  "durable_objects": {
    "bindings": [
      { "name": "CUADERNO", "class_name": "Cuaderno" },
      { "name": "OPERADOR", "class_name": "Operador" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Cuaderno"] },
    { "tag": "v2", "new_sqlite_classes": ["Operador"] }
  ],

  /* El puente (tracker/, crm-medidor): los agentes mandan los WhatsApp por
     aquí, sin salir a internet. La clave del puente la ponen en Conexiones. */
  "services": [{ "binding": "PUENTE", "service": "crm-medidor" }],

  /* Sólo la dirección propia, que es la que cuida Cloudflare Access. Las
     direcciones automáticas de workers.dev quedarían fuera de Access. */
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "crm.raadsports.com", "custom_domain": true }],

  /* Se llenan después de crear la aplicación en Cloudflare Access (paso 3 del
     README). Mientras estén vacíos, /api/ no responde a nadie. */
  "vars": {
    /* Amazon SES, para el correo de las campañas (nube/ses.js). Las llaves
       van aparte: wrangler secret put AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY.
       Vacío, las campañas salen sólo por WhatsApp. */
    "SES_REGION": "",
    "SES_FROM": "",
    "ACCESS_EQUIPO": "https://quiet-hill-7383.cloudflareaccess.com",
    "ACCESS_AUD": "f77abf9451e89957aab1122906de15f8f91c772104433288ecec3f7d4b2dae7e"
  },

  /* A las 6:00 de Bogotá (11:00 UTC) Claude busca tendencias, JEV califica y
     el Agente de Contenido arma la campaña del día. Cada diez minutos, el de
     Campañas y el de Seguimiento. Ver nube/marketing.js. */
  "triggers": { "crons": ["0 11 * * *", "*/10 * * * *"] },

  "observability": { "enabled": true }
}
